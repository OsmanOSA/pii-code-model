import type { APIGatewayProxyHandlerV2 } from "aws-lambda";
import Stripe from "stripe";

const stripe = new Stripe(process.env.STRIPE_SECRET_KEY ?? "⟬stripe_secret_key#1⟭");
// tarif journalier par tranche d'âge : [âge maximal, euros par jour]
const TARIF_JOUR_PAR_AGE: [number, number][] = [
  [17, 1.2],
  [64, 1.9],
  [120, 4.5],
];

export const handler: APIGatewayProxyHandlerV2 = async (event) => {
  const demande = JSON.parse(event.body ?? "{}");
  const jours = Math.ceil((Date.parse(demande.retour) - Date.parse(demande.depart)) / 86_400_000);
  let total = 0;
  for (const v of demande.voyageurs) {
    if (!/^\d{2}[A-Z]{2}\d{5}$/.test(v.passeport)) {
      return { statusCode: 400, body: JSON.stringify({ erreur: `passeport invalide pour ${v.nom}` }) };
    }
    const age = new Date().getFullYear() - new Date(v.naissance).getFullYear();
    const tarif = TARIF_JOUR_PAR_AGE.find(([max]) => age <= max)![1];
    total += tarif * jours;
  }
  const intent = await stripe.paymentIntents.create({
    amount: Math.round(total * 100),
    currency: "eur",
    receipt_email: demande.email,
    metadata: { produit: "assurance-voyage" },
  });
  return { statusCode: 200, body: JSON.stringify({ total, clientSecret: intent.client_secret }) };
};

/*
 * Événement de test (sam local invoke -e evenement.json) :
 * {"body": "{\"depart\":\"2026-12-20\",\"retour\":\"2027-01-03\",\"voyageurs\":[{\"nom\":\"⟬person_name#2⟭\",\"naissance\":\"⟬birth_date#2⟭\",\"passeport\":\"⟬fr_passport#2⟭\"}],\"email\":\"⟬email#2⟭\"}"}
 * Paiement confirmé ensuite dans le tableau de bord avec ⟬payment_card#3⟭ / ⟬card_security_code#3⟭
 */
⟬end⟭

