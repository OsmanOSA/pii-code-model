package fr.caviste.livraison;

import static org.assertj.core.api.Assertions.assertThat;
import static org.awaitility.Awaitility.await;

import java.time.Duration;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.kafka.core.KafkaTemplate;
import org.springframework.kafka.test.context.EmbeddedKafka;

@SpringBootTest
@EmbeddedKafka(topics = "commandes.creees")
class LivraisonAlcoolListenerTest {

    @Autowired
    private KafkaTemplate<String, String> kafka;

    @Autowired
    private LivraisonRepository livraisons;

    // événement capturé sur le topic de recette. FIXME : le producteur ne devrait jamais publier la carte ni le cvv
    private static final String EVENEMENT = """
        {
          "commande": "⟬order_number#1⟭",
          "client": {"nom": "⟬person_name#2⟭", "naissance": "⟬birth_date#2⟭", "telephone": "⟬phone#2⟭"},
          "livraison": {"adresse": "⟬fr_postal_address#2⟭", "creneau": "18:00-20:00"},
          "controleAge": {"piece": "CNI", "numero": "⟬fr_identity_card#2⟭"},
          "paiement": {"carte": "⟬payment_card#2⟭", "cvv": "⟬card_security_code#2⟭"},
          "lignes": [{"sku": "VIN-ROUGE-CAHORS-2019", "qte": 6}]
        }
        """;

    @Test
    void creeUneLivraisonAvecControleDIdentite() {
        kafka.send("commandes.creees", "⟬order_number#1⟭", EVENEMENT);

        await().atMost(Duration.ofSeconds(10)).untilAsserted(() -> {
            Livraison l = livraisons.findByCommande("⟬order_number#1⟭").orElseThrow();
            assertThat(l.isControleAgeRequis()).isTrue();
            assertThat(l.getPieceAttendue()).isEqualTo("CNI");
        });
    }
}
