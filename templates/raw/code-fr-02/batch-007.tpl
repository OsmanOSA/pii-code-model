<?php

namespace App\Services;

use Illuminate\Support\Facades\Cache;
use Illuminate\Support\Facades\Http;
use Illuminate\Support\Facades\Log;

/**
 * Itinéraires et temps de trajet des camions entre nos dépôts.
 * Dépôt principal : ⟬company#1⟭ (SIREN ⟬fr_siren#1⟭), ⟬fr_postal_address#1⟭.
 */
class ItineraireService
{
    private const CLE = '⟬google_api_key#2⟭';

    public function duree(string $depart, string $arrivee, string $plaque): int
    {
        $cle = 'itineraire:' . md5($depart . '|' . $arrivee);

        return Cache::remember($cle, now()->addHours(6), function () use ($depart, $arrivee, $plaque) {
            $reponse = Http::get('https://maps.googleapis.com/maps/api/directions/json', [
                'origin' => $depart,
                'destination' => $arrivee,
                'mode' => 'driving',
                'avoid' => 'ferries',
                'key' => self::CLE,
            ])->json();
            if (($reponse['status'] ?? '') !== 'OK') {
                Log::warning('itinéraire introuvable', ['camion' => $plaque, 'statut' => $reponse['status'] ?? null]);
                return -1;
            }
            return $reponse['routes'][0]['legs'][0]['duration']['value'];
        });
    }
}

// laravel.log, ⟬date#1⟭ 05:12:44 :
// production.WARNING: itinéraire introuvable {"camion":"⟬fr_license_plate#3⟭","statut":"ZERO_RESULTS"}
