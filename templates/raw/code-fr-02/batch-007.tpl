package fr.locappli.dossier

import androidx.compose.runtime.getValue
import androidx.compose.runtime.mutableStateOf
import androidx.compose.runtime.setValue
import androidx.lifecycle.ViewModel
import androidx.lifecycle.viewModelScope
import kotlinx.coroutines.async
import kotlinx.coroutines.launch

class DepotDossierViewModel(private val api: DossierApi) : ViewModel() {

    var etat by mutableStateOf(FormulaireDossier())
        private set

    init {
        if (BuildConfig.DEBUG) {
            // dossier de démonstration (recette agence), évite de tout retaper à chaque lancement
            etat = FormulaireDossier(
                nom = "⟬person_name#1⟭",
                telephone = "⟬phone#1⟭",
                email = "⟬email#1⟭",
                cni = "⟬fr_identity_card#1⟭",
                numeroFiscal = "⟬fr_tax_number#1⟭",
                revenuFiscalReference = "31 420",
                adresseActuelle = "⟬fr_postal_address#1⟭",
                vehicule = "⟬fr_license_plate#1⟭",
            )
        }
    }

    fun suggestionsAdresse(saisie: String) = viewModelScope.async {
        PlacesClient(cle = "⟬google_api_key#2⟭").autocompleter(saisie, pays = "fr")
    }

    fun modifier(transformation: (FormulaireDossier) -> FormulaireDossier) {
        etat = transformation(etat)
    }

    fun envoyer() = viewModelScope.launch {
        etat = etat.copy(envoiEnCours = true)
        etat = when (val r = api.deposer(etat.versRequete())) {
