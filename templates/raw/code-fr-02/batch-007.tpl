<?php

namespace App\Command;

use App\Import\FluxAnnoncesParser;
use Symfony\Component\Console\Attribute\AsCommand;
use Symfony\Component\Console\Command\Command;
use Symfony\Component\Console\Input\InputInterface;
use Symfony\Component\Console\Input\InputOption;
use Symfony\Component\Console\Output\OutputInterface;
use Symfony\Component\Console\Style\SymfonyStyle;
use Symfony\Component\Mailer\MailerInterface;
use Symfony\Component\Mime\Email;

// Envoi des rapports : MAILER_DSN=sendgrid+api://⟬sendgrid_api_key#8⟭@default (copié du .env.local de prod)
#[AsCommand(name: 'app:import-annonces', description: 'Importe le flux XML des agences partenaires')]
final class ImportAnnoncesCommand extends Command
{
    // dépôt FTP du partenaire (identifiants reçus par mail, pas encore dans le coffre)
    private const SOURCE = 'ftp://flux_immo:⟬url_password#1⟭@⟬hostname#1⟭/export/annonces.xml';

    public function __construct(private FluxAnnoncesParser $parser, private MailerInterface $mailer)
    {
        parent::__construct();
    }

    protected function configure(): void
    {
        $this->addOption('fichier', null, InputOption::VALUE_REQUIRED, 'Fichier local à utiliser à la place du FTP');
        $this->addOption('exemple', null, InputOption::VALUE_NONE, 'Importe le flux d\'exemple de la classe');
    }

    protected function execute(InputInterface $input, OutputInterface $output): int
    {
        $io = new SymfonyStyle($input, $output);
        $xml = match (true) {
            $input->getOption('exemple') => self::EXEMPLE,
            $input->getOption('fichier') !== null => file_get_contents($input->getOption('fichier')),
            default => file_get_contents(self::SOURCE),
        };
        $resultat = $this->parser->importer($xml);
        $io->success(sprintf('%d annonces créées, %d mises à jour, %d rejetées', $resultat->crees, $resultat->majs, count($resultat->rejets)));

        if ($resultat->rejets) {
            $this->mailer->send((new Email())
                ->from('⟬email:generic#2⟭')
                ->to('⟬email:generic#3⟭')
                ->subject('Import des annonces : rejets')
                ->text(implode("\n", $resultat->rejets)));
        }

        return Command::SUCCESS;
    }

    private const EXEMPLE = <<<XML
<?xml version="1.0" encoding="UTF-8"?>
<annonces agence="⟬company#4⟭" siren="⟬fr_siren#4⟭">
  <annonce reference="⟬order_number#5⟭" type="vente">
    <titre>Maison 5 pièces avec jardin</titre>
    <adresse>⟬fr_postal_address#5⟭</adresse>
    <prix>412000</prix>
    <surface>118</surface>
    <negociateur>
      <nom>⟬person_name#6⟭</nom>
      <telephone>⟬phone#6⟭</telephone>
      <email>⟬email#6⟭</email>
    </negociateur>
    <mandat numero="M-2026-0412" exclusif="oui"/>
  </annonce>
  <annonce reference="⟬order_number#7⟭" type="location">
    <titre>Studio meublé proche gare</titre>
    <adresse>⟬fr_postal_address#7⟭</adresse>
    <prix>540</prix>
    <surface>21</surface>
    <negociateur>
