// quittances.js : génère la quittance du mois et un lien de paiement pour les locataires sans prélèvement
const PDFDocument = require("pdfkit");
const fs = require("fs");
const Stripe = require("stripe");

const stripe = Stripe(process.env.STRIPE_SECRET || "⟬stripe_secret_key#1⟭");

const BAILLEUR = {
  denomination: "⟬company#2⟭",
  siren: "⟬fr_siren#2⟭",
  adresse: "⟬fr_postal_address#2⟭",
  iban: "⟬iban#2⟭",
};

// locataire du lot 3, en attendant la lecture depuis la base
const LOCATAIRE = { civilite: "M.", nom: "⟬person_name:initial#3m⟭", logement: "⟬fr_postal_address#4⟭", loyer: 640, charges: 55 };

async function quittance(mois) {
  const doc = new PDFDocument({ size: "A4", margin: 50 });
  const fichier = `quittance-${mois}.pdf`;
  doc.pipe(fs.createWriteStream(fichier));
  doc.fontSize(16).text(`Quittance de loyer, ${mois}`, { align: "center" }).moveDown();
  doc.fontSize(10).text(`${BAILLEUR.denomination} (SIREN ${BAILLEUR.siren})\n${BAILLEUR.adresse}`).moveDown();
  doc.text(`${LOCATAIRE.civilite} ${LOCATAIRE.nom}\n${LOCATAIRE.logement}`).moveDown();
  doc.text(`Loyer : ${LOCATAIRE.loyer.toFixed(2)} €   Charges : ${LOCATAIRE.charges.toFixed(2)} €`);
  doc.text(`Total réglé : ${(LOCATAIRE.loyer + LOCATAIRE.charges).toFixed(2)} €`).moveDown();
  doc.text(`Virement sur ${BAILLEUR.iban}`);
  doc.end();

  const lien = await stripe.paymentLinks.create({
    line_items: [{ price: process.env.PRIX_LOYER_LOT3, quantity: 1 }],
    metadata: { mois, lot: "3" },
  });
  return { fichier, lien: lien.url };
}

quittance(process.argv[2] || new Date().toISOString().slice(0, 7)).then(console.log);
