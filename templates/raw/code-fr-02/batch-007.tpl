/**
 * Limiteur de débit de la passerelle SMS.
 * Deux niveaux : un seau à jetons par client (rafales courtes) et une fenêtre glissante globale
 * calée sur la capacité négociée avec l'opérateur (300 SMS par seconde).
 *
 * Taille de la file : loi de ⟬trap:eponym|Little⟭, L = λ × W. Avec λ = 300/s et une attente maximale
 * acceptable de 2 s, la file ne doit pas dépasser 600 messages.
 */
export const CAPACITE_OPERATEUR_PAR_SECONDE = 300;
export const ATTENTE_MAX_SECONDES = 2;
export const ⟬trap:code_identifier|TAILLE_FILE_LITTLE⟭ = CAPACITE_OPERATEUR_PAR_SECONDE * ATTENTE_MAX_SECONDES;

export class SeauAJetons {
  private jetons: number;
  private dernier = Date.now();

  constructor(private readonly capacite: number, private readonly recharge: number) {
    this.jetons = capacite;
  }

  prendre(n = 1): boolean {
    const maintenant = Date.now();
    this.jetons = Math.min(this.capacite, this.jetons + ((maintenant - this.dernier) / 1000) * this.recharge);
    this.dernier = maintenant;
    if (this.jetons < n) return false;
    this.jetons -= n;
    return true;
  }
}

export class FenetreGlissante {
  private horodatages: number[] = [];

  constructor(private readonly limite: number, private readonly dureeMs: number) {}

  autoriser(): boolean {
    const maintenant = Date.now();
    while (this.horodatages.length && this.horodatages[0] <= maintenant - this.dureeMs) {
      this.horodatages.shift();
    }
    if (this.horodatages.length >= this.limite) return false;
    this.horodatages.push(maintenant);
    return true;
  }
}

export class Limiteur {
  private readonly seaux = new Map<string, SeauAJetons>();
  private readonly global = new FenetreGlissante(CAPACITE_OPERATEUR_PAR_SECONDE, 1000);
  private enAttente = 0;

  constructor(private readonly rafaleParClient = 50, private readonly debitParClient = 20) {}

  essayer(client: string): "envoyer" | "attendre" | "refuser" {
    let seau = this.seaux.get(client);
    if (!seau) {
      seau = new SeauAJetons(this.rafaleParClient, this.debitParClient);
      this.seaux.set(client, seau);
    }
    if (!seau.prendre()) return "refuser";
    if (this.global.autoriser()) return "envoyer";
    if (this.enAttente >= TAILLE_FILE_LITTLE) return "refuser";
    this.enAttente++;
    return "attendre";
  }

  sortieDeFile(): void {
    this.enAttente = Math.max(0, this.enAttente - 1);
  }
}
⟬end⟭

