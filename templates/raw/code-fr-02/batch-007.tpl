package fr.librairie.api.erreurs;

import java.util.List;
import java.util.Map;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.MethodArgumentNotValidException;
import org.springframework.web.bind.annotation.ExceptionHandler;
import org.springframework.web.bind.annotation.RestControllerAdvice;

/**
 * Traduction des erreurs de validation en messages lisibles par le client.
 * Revu par ⟬trap:initials|TB⟭ : ne jamais renvoyer la valeur saisie, seulement le nom du champ.
 */
@RestControllerAdvice
public class GestionErreurs {

    private static final Map<String, String> MESSAGES = Map.of(
        "email", "adresse e-mail invalide",
        "telephone", "numéro de téléphone invalide",
        "codePostal", "code postal sur 5 chiffres",
        ⟬trap:indicator_non_pii|"motDePasse", "12 caractères minimum dont un chiffre"⟭,
        "carte", "numéro de carte refusé par le contrôle de saisie");

    @ExceptionHandler(MethodArgumentNotValidException.class)
    public ResponseEntity<Map<String, Object>> validation(MethodArgumentNotValidException e) {
        List<Map<String, String>> erreurs = e.getBindingResult().getFieldErrors().stream()
            .map(f -> Map.of("champ", f.getField(), "message", MESSAGES.getOrDefault(f.getField(), "valeur invalide")))
            .toList();
        return ResponseEntity.badRequest().body(Map.of("erreurs", erreurs));
    }

    @ExceptionHandler(StockInsuffisantException.class)
    public ResponseEntity<Map<String, Object>> stock(StockInsuffisantException e) {
        return ResponseEntity.status(HttpStatus.CONFLICT)
            .body(Map.of("code", "STOCK", "isbn", e.getIsbn(), "disponible", e.getDisponible()));
    }
}
