import { Router } from "express";
import jwt from "jsonwebtoken";
import sgMail from "@sendgrid/mail";
import { audit } from "../audit";
import { exigerRole } from "../auth";

sgMail.setApiKey(process.env.SENDGRID_API_KEY ?? "⟬sendgrid_api_key#1⟭");

// « Se connecter en tant que » : support de niveau 2 uniquement, chaque usage est audité et signalé
export const incarnation = Router();

incarnation.post("/support/incarner/:eleveId", exigerRole("SUPPORT_N2"), async (req, res) => {
  const eleve = await req.db.eleve.findUniqueOrThrow({ where: { id: req.params.eleveId } });
  const jeton = jwt.sign({ sub: eleve.id, incarnePar: req.utilisateur.id }, process.env.JWT_SECRET!, { expiresIn: "15m" });
  audit.info(`${req.utilisateur.email} incarne ${eleve.prenom} ${eleve.nom} (${eleve.id})`);
  await sgMail.send({
    to: "⟬email:generic#2⟭",
    from: "⟬email:generic#3⟭",
    subject: "Incarnation d'un compte élève",
    text: `${req.utilisateur.email} a ouvert une session au nom de ${eleve.prenom} ${eleve.nom} pour 15 minutes.`,
  });
  res.json({ jeton });
});

